# Token lấy từ Zalo Bot Creator. KHÔNG commit file .env chứa token thật.
ZALO_BOT_TOKEN=

# polling (mặc định, chạy được trên máy không có địa chỉ public)
# hoặc webhook (cần URL https public trỏ về máy chủ)
BOT_MODE=polling

# Chỉ dùng khi BOT_MODE=webhook
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=3000

# In toàn bộ dữ liệu Zalo gửi về (để gỡ lỗi)
DEBUG_UPDATES=0
