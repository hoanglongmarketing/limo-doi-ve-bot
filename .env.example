# Token lấy từ Zalo Bot Creator. KHÔNG commit file .env chứa token thật.
ZALO_BOT_TOKEN=

# polling (mặc định, chạy được trên máy không có địa chỉ public)
# hoặc webhook (cần URL https public trỏ về máy chủ)
BOT_MODE=polling

# Chỉ dùng khi BOT_MODE=webhook
WEBHOOK_URL=
WEBHOOK_SECRET=
PORT=3000

# In toàn bộ dữ liệu Zalo gửi về (để gỡ lỗi)
DEBUG_UPDATES=0

# Zalo user id của người duyệt (nhiều id cách nhau bằng dấu phẩy).
# Xem id trong log của bot khi người đó nhắn @bot. Để trống thì bản test tạm nhận theo tên hiển thị.
# Ms Ngọc Anh duyệt vé đi từ Hải Phòng (HP)
APPROVER_HAI_PHONG_IDS=
# Mr Thanh Việt duyệt vé đi từ Hà Nội (HN) hoặc Hà Đông (HĐ)
APPROVER_HA_NOI_IDS=

# Nhóm Zalo nhận yêu cầu đổi vé (nhiều nhóm cách nhau dấu phẩy). Để trống: nhận ở mọi nhóm.
# Lấy ID: thêm bot vào nhóm rồi nhắn "@Bot HL Support id".
REQUEST_GROUP_IDS=
# Nhóm Zalo nhận báo cáo khi yêu cầu được duyệt hoặc từ chối.
REPORT_GROUP_ID=

# File lưu dữ liệu đổi vé (mặc định data/requests.json)
DATA_FILE=data/requests.json

# Google Sheet: URL Web App của Apps Script và mật khẩu (SECRET trong script). Xem docs/google-sheet.md
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=
