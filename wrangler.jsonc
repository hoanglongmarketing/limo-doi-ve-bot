// Cấu hình Cloudflare Workers. Hướng dẫn: docs/cloudflare.md
{
  "name": "limo-doi-ve-bot",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "BOT", "class_name": "BotState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BotState"] }],
  // Mỗi phút Cloudflare hỏi Zalo có tin mới không (chế độ polling, mặc định).
  "triggers": { "crons": ["* * * * *"] },
  // Các biến (nhóm Zalo, người duyệt, API Hoàng Long, Google Sheet...) đặt trên trang Cloudflare,
  // KHÔNG ghi ở đây: biến ghi trong file này sẽ ghi đè giá trị trên trang mỗi lần deploy.
  // keep_vars giữ nguyên các biến đang có trên trang khi deploy lại. Danh sách biến: docs/cloudflare.md
  "keep_vars": true
  // Secrets đặt trên trang Cloudflare (không ghi vào đây): ZALO_BOT_TOKEN, WEBHOOK_SECRET, SHEET_WEBHOOK_SECRET,
  // HL_API_USERNAME, HL_API_KEY
}
